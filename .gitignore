# Binaries
/cairn
/cairn-*
# 历史冒烟产物命名(老命名 cairn-smoke-*),继续忽略避免误 add
/cairn-smoke-*
/.cairn-smoke-*
/cairn-smoke-*.mjs
/cmd/server/server
*.exe
*.test
*.out

# Go workspace
go.work
go.work.sum

# Build artifacts
/dist
/tmp/
# v0.5.43：go mod vendor 产物。仓库默认走 GOPROXY 下载模块,不带 vendor/;
# 这条 ignore 让本地偶尔跑 `go mod vendor` 调试时不会进版本库
/vendor/

# Env (matches registry-manager convention: never commit secrets)
/.env
.env.local
.env.*.local

# Local config (mirrors registry.config.json convention from registry-manager)
/registry.config.json

# Frontend
/web/node_modules/
/web/dist/
/web/.vite/
# pnpm build 产物：go:embed 的源，由构建产生，不入库
/internal/webui/dist/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
.tmp_*.conf
.tmp_*.py
.tmp_*.go

# 本地临时产物统一落这里（补丁脚本 / 探针 / 构建日志 / 验证副本）
# 该目录整体不进版本库，内容可随时清理
/tmps/

# 端到端 UI 测试配置（仅内部验收用，含内网部署地址）
/tests/web-auto/

# 发布脱敏脚本（本地一次性工具）
/.scrub-publish.sh
/.scrub-replace.txt
/.scrub-message.txt
/.tmp_*.sh
/.git.bak-pre-filter-repo

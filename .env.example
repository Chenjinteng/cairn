# cairn 的环境变量约定（v0.5.9）。
#
# 所有业务配置（仓库地址 / 代理 / 认证 / 平台白名单 / 热度等）现在统一
# 通过 Web UI → SQLite settings 表 修改，环境变量不再起覆盖作用。改完
# UI 保存立即生效，无需重启。本文件只剩基础设施 / 构建期变量。
#
# 复制: cp .env.example .env

# ── 运行时基础设施（容器编排必须，缺失或格式错会启动失败） ─────────────
# 凭据库加密密钥（AES-256-GCM），丢失后凭据永久不可恢复
#   openssl rand -hex 32
REGISTRY_CREDENTIAL_KEY=please-change-me-to-a-random-32-byte-hex-string

# HTTP 监听端口（容器内固定 8787）
PORT=8787

# 数据目录：凭据 / 代理 / SQLite 都放这里（与 registry 内容物理隔离）
REGISTRY_CREDENTIALS_DIR=/app/data

# blob / manifest / tag 物理路径
# 默认 <REGISTRY_CREDENTIALS_DIR>/registry；docker-compose 用独立命名卷
# cairn-registry 挂载这里。想把 registry 内容挂到宿主机某目录时改成
# 本地路径，例如：  REGISTRY_STORAGE_DIR=/data/cairn/registry
REGISTRY_STORAGE_DIR=/app/registry

# dev / prod：dev 模式下 CORS 放宽、verbose 日志；prod 默认
GO_HUB_ENV=prod

# ── 宿主机端口映射（仅 docker-compose 用，运行时不影响容器内 8787） ─────
HOST_PORT=80

# ── 镜像标签 ──────────────────────────────────────────────────────────────
# 推到内网 registry 时改成带前缀的完整名
# 跟 docker-compose.yml 的 image 字段、CHANGELOG.md 的最新版保持一致
IMAGE=cairn:0.5.15

# ---- 构建参数（仅 docker compose build 时生效，留空走默认） ----
# 前端构建镜像（v0.4 起 Dockerfile 用 node 构建 web/ 前端并 embed 进二进制）
NODE_IMAGE=node:22-alpine
# 内网 npm registry 镜像（前端依赖下载走它；留空用默认 registry.npmjs.org）
NPM_REGISTRY=

# ── Go 模块代理（仅 docker build 时生效） ────────────────────────────────
# 构建机访问 proxy.golang.org 受限 / 超时时改成国内镜像后取消注释，例如：
#   GOPROXY=https://goproxy.cn,direct
#   GOPROXY=https://goproxy.io,direct
# 多源用逗号分隔，direct 表示直连私有 module；留空走默认（等价
# proxy.golang.org,direct）。也可以绕过 compose，build 时覆盖：
#   docker compose build --build-arg GOPROXY=https://goproxy.cn,direct
GOPROXY=

# ── 构建期 HTTP 代理（可选，仅 docker build 时生效） ─────────────────────
# 跟 GOPROXY 正交：HTTP_PROXY / HTTPS_PROXY 影响 builder stage 内所有
# 网络出口（go / curl / git / apt 等）；GOPROXY 只影响 Go module 协议。
#
# 典型用法：构建机直连外网受限、内网有可用 HTTP 代理时
# （如 proxy.example.com:7890）。留空 = 不设代理（行为跟之前一致）。
# 注意：这些 env 也会被基础镜像拉取阶段的工具读到，要 NO_PROXY 排除
# docker 内部地址避免 build 卡在拉 base image；典型值：
# localhost,127.0.0.1,.local
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=

# cairn 的环境变量约定。
# 与 registry-manager 保持字段名一致，方便复用 .env 文件。
# 复制: cp .env.example .env
#
# v0.5.0 变更：REGISTRY_URL 不再是必填 —— cairn 现在管理自己，空值时
# pull 任务回退到 Docker Hub。所有其它 REGISTRY_* 字段保留。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 凭据库加密密钥（AES-256-GCM），丢失后凭据永久不可恢复
#   openssl rand -hex 32
REGISTRY_CREDENTIAL_KEY=please-change-me-to-a-random-32-byte-hex-string

# HTTP 监听端口（容器内固定 8787）
PORT=8787

# 宿主机映射端口（浏览器访问 cairn 用）
# 容器内始终监听 8787，这里只决定宿主机侧；示例 80 = http://<宿主机>:80
# 留空则回退到 docker-compose 默认值 8787
HOST_PORT=80

# ── 可选：上游 registry ─────────────────────────────────────────────────────
# v0.5.0 起为可选；留空 = pull 任务回退到 Docker Hub（pull.DefaultUpstream）
# 填写后作为默认上游；具体 pull 任务仍可在 UI 上单独指定别的源。
# 示例：http://192.0.2.10:10001
REGISTRY_URL=

# ── 可选：能力开关 ─────────────────────────────────────────────────────────
# 设为 false 进入只读模式（DELETE /api/repositories 与 DELETE manifest-by-digest 同时被禁）
REGISTRY_ALLOW_DELETE=true
# 设为 false 拒绝所有 /api/pull/* 写入
REGISTRY_ALLOW_PULL=true

# 内存里保留的最近任务数
REGISTRY_PULL_QUEUE_SIZE=50
# 拉取历史保留天数
REGISTRY_PULL_HISTORY_RETENTION_DAYS=90

# v0.6.0：多架构镜像拉取时只保留这些平台（其余跳过）。
# 留空 = 按上游索引全部拉取（与 v0.6.0 之前的行为一致）。
# 单架构/双架构部署强烈建议取消下一行注释，避免拉一堆用不到的层。
# 格式：<os>/<arch>[/<variant>] 的 CSV，例如：
#   REGISTRY_PULL_PLATFORMS=linux/amd64,linux/arm64
# 也可只留一个（仅 x86_64）：
#   REGISTRY_PULL_PLATFORMS=linux/amd64
# 同样支持 arm/v7 等带 variant 的写法：linux/arm/v7
REGISTRY_PULL_PLATFORMS=

# 展示名称（出现在 UI 顶部）
REGISTRY_NAME=内网离线镜像源

# 访问本 registry 的 HTTP 代理；留空直连
REGISTRY_PROXY=
# 本 registry 自身的 basic auth（仅在反代 / 边界场景需要）
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 清单缓存时长（秒）
REGISTRY_CACHE_TTL_SECONDS=60

# ── 可选：镜像存储路径 ─────────────────────────────────────────────────────
# v0.5.0 新增。blob / manifest / tag 物理路径。
# 默认 /app/registry；docker-compose 用独立命名卷 cairn-registry 挂载这里。
# 想把 registry 内容挂到宿主机某目录时改成本地路径，例如：
#   REGISTRY_STORAGE_DIR=/data/cairn/registry
REGISTRY_STORAGE_DIR=/app/registry

# ── 可选：镜像热度 ─────────────────────────────────────────────────────────
# v0.5.8：自带 registry 自动计入 push/pull，零配置、零依赖。
# 下面这些变量现在只对「外部」registry（Docker Distribution / Harbor 等）生效：
#   REGISTRY_NOTIFY_TOKEN —— 外部 registry 推 webhook 到 /api/events 时的
#                            共享密钥（HMAC-SHA256）。空 = 外部 webhook 全拒
#                            （401 fail-closed），但自带 registry 不受影响。
#   REGISTRY_ALLOW_REGISTRY_EVENTS —— 全局 kill switch（隐藏；UI 无开关）。
#                                   true/false，运行时生效（改 .env 重启即可）。
#   REGISTRY_STATS_RETENTION_DAYS —— 超过的天数会被 /api/stats/heat 自动清掉。
#   REGISTRY_STATS_IGNORE_USERAGENTS —— 命中 UA 子串的事件折叠进 ignored
#                                       计数，不进热度表、不挤占最近事件环。
REGISTRY_NOTIFY_TOKEN=
REGISTRY_ALLOW_REGISTRY_EVENTS=true
REGISTRY_STATS_RETENTION_DAYS=365
REGISTRY_STATS_IGNORE_USERAGENTS=

# ── 凭据库 / 应用数据目录 ─────────────────────────────────────────────────
# 凭据 / 代理 / SQLite 都放这里（与 registry 内容物理隔离）
REGISTRY_CREDENTIALS_DIR=/app/data

# ── 镜像标签 ───────────────────────────────────────────────────────────────
# 推到内网 registry 时改成带前缀的完整名
# 跟 docker-compose.yml 的 image 字段、CHANGELOG.md 的最新版保持一致
IMAGE=cairn:0.5.8

# ---- 构建参数（仅 docker compose build 时生效，留空走默认） ----
# 前端构建镜像（v0.4 起 Dockerfile 用 node 构建 web/ 前端并 embed 进二进制）
NODE_IMAGE=node:22-alpine
# 内网 npm registry 镜像（前端依赖下载走它；留空用默认 registry.npmjs.org）
NPM_REGISTRY=

# ── Go 模块代理(仅 docker build 时生效)─────────────────────────────────────
# 构建机访问 proxy.golang.org 受限 / 超时时改成国内镜像后取消注释,例如:
#   GOPROXY=https://goproxy.cn,direct
#   GOPROXY=https://goproxy.io,direct
# 多源用逗号分隔,direct 表示直连私有 module;留空走默认(等价 proxy.golang.org,direct)。
# 也可以绕过 compose,直接 build 时覆盖:
#   docker compose build --build-arg GOPROXY=https://goproxy.cn,direct
GOPROXY=

# ── 构建期 HTTP 代理(可选,仅 docker build 时生效)──────────────────────────
# 跟 GOPROXY 正交:HTTP_PROXY / HTTPS_PROXY 影响 builder stage 内所有网络出口
# (go / curl / git / apt 等);GOPROXY 只影响 Go module 协议。
#
# 典型用法:构建机直连外网受限、内网有可用 HTTP 代理时(如 proxy.example.com:7890)。
# 内网代理示例:BUILD_HTTP_PROXY=http://proxy.example.com:7890
#
# 留空 = 不设代理(行为跟之前一致)。
# 注意:这些 env 也会被基础镜像拉取阶段的工具读到,要 NO_PROXY 排除 docker 内部地址
# 避免 build 卡在拉 base image;典型值:localhost,127.0.0.1,.local
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=

# ── 框架扩展位 ─────────────────────────────────────────────────────────────
# dev / prod：dev 模式下 CORS 放宽、verbose 日志；prod 默认
GO_HUB_ENV=prod
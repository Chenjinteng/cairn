# Cairn（cairn） 的环境变量约定。
#
# 所有业务配置（仓库地址 / 代理 / 认证 / 平台白名单 / 热度等）统一通过
# Web UI → SQLite settings 表 修改，环境变量不再起覆盖作用 —— v0.5.9 起
# .env 里写 REGISTRY_URL / REGISTRY_PROXY / REGISTRY_ALLOW_* / 保留天数
# 之类一律不会被读。改完 UI 保存立即生效，无需重启。
#
# 本文件只剩两类变量：
#   1. 运行时基础设施：加密密钥、宿主机端口、宿主机数据目录；
#   2. 构建期参数：镜像 / 代理 / registry 镜像源（文件后半段）。
#
# 容器内路径（/app/data、/app/data/registry）是编译期常量，不对外开放 ——
# 容器里的路径由 Cairn 自己定义。需要挪数据只改宿主机侧的 HOST_DATA_DIR。
#
# v0.5.23: GO_HUB_ENV → CAIRN_ENV；IMAGE 默认 cairn:0.5.22 → cairn:0.5.23。
# 旧名不兼容 —— 从 0.5.22 升级到 0.5.23 必须把 .env 里的两行改名(改名清单
# 见 CHANGELOG 该条目)。
#
# 复制: cp .env.example .env

# ── 运行时：凭据库加密密钥（AES-256-GCM） ────────────────────────────────
# 必填。丢失后已存凭据永久不可恢复，请跟数据目录一起备份。
#   openssl rand -hex 32
REGISTRY_CREDENTIAL_KEY=please-change-me-to-a-random-32-byte-hex-string

# ── 运行时：宿主机数据目录（唯一需要关心的路径） ──────────────────────────
# 宿主机上存放全部状态的目录，整体 bind mount 到容器 /app/data：
#   credentials.json（凭据库） / proxies.json（代理库）
#   cairn.db + heat.db（SQLite：设置 / 热度 / 拉取历史）
#   registry/（镜像 blobs / manifests / tags）
#
# 备份 = 打包这一个目录；迁移 = 拷贝这一个目录。
# 目录不存在时 docker 会以 root 建一个空目录 —— 从旧部署升级请先按 README
# 「部署」一节迁移旧数据，否则会看到一个空仓库。
# v0.5.23：默认值仍是 /data/cairn，**不改** —— 它是宿主机上的物理路径，
# 不是产品名的一部分，改了只会让老运维脚本找不到数据。
HOST_DATA_DIR=/data/cairn

# ── 运行时：宿主机端口映射 ───────────────────────────────────────────────
# 容器内监听端口固定 8787（已烘进镜像），对外访问端口用这个改。
# v0.5.40 起 docker-compose.yml 会把这个值传给容器内的 cairn 进程,UI 「监听端口」
# 字段会同时显示「容器内 8787 / 宿主机 80」两个端口。跟上方 docker-compose 的
# ports 映射保持一致;不传 = UI 只显示容器内端口。
HOST_PORT=80

# ── 运行时：dev / prod ───────────────────────────────────────────────────
# dev 模式 CORS 放宽、verbose 日志；prod 默认。
# v0.5.23: GO_HUB_ENV → CAIRN_ENV。
CAIRN_ENV=prod

# ── 镜像标签 ──────────────────────────────────────────────────────────────
# 推到内网 registry 时改成带前缀的完整名
# 跟 docker-compose.yml 的 image 字段、CHANGELOG.md 的最新版保持一致
# v0.5.23: cairn:0.5.22 → cairn:0.5.23。docker image 的 tag 本身不影响运行,
# 只是一个字符串,但保持「image 名 = 产品名」能减少运维的混淆。
IMAGE=cairn:0.5.45

# ---- 构建参数（仅 docker compose build 时生效，留空走默认） ----
# 前端构建镜像（v0.4 起 Dockerfile 用 node 构建 web/ 前端并 embed 进二进制）
NODE_IMAGE=node:22-alpine
# 内网 npm registry 镜像（前端依赖下载走它；留空用默认 registry.npmjs.org）
NPM_REGISTRY=

# ── Go 模块代理（仅 docker build 时生效） ────────────────────────────────
# 默认走 goproxy.io(国内 / 受限网络也能访问);proxy.golang.org 在受限网络里
# 会 i/o timeout。如果走 Makefile (make build / make rebuild),本设置不生效
# —— Makefile 自带 GOPROXY ?= https://goproxy.io,direct 默认,会覆盖这里。
# 需要换镜像源(如公司内网 Nexus)直接改这一行,留空 = 退回 proxy.golang.org。
GOPROXY=https://goproxy.io,direct

# ── 构建期 HTTP 代理（可选，仅 docker build 时生效） ─────────────────────
# 跟 GOPROXY 正交：HTTP_PROXY / HTTPS_PROXY 影响 builder stage 内所有
# 网络出口（go / curl / git / apt 等）；GOPROXY 只影响 Go module 协议。
#
# 典型用法：构建机直连外网受限、内网有可用 HTTP 代理时
# （如 proxy.example.com:7890）。留空 = 不设代理（行为跟之前一致）。
# 注意：这些 env 也会被基础镜像拉取阶段的工具读到，要 NO_PROXY 排除
# docker 内部地址避免 build 卡在拉 base image；典型值：
# localhost,127.0.0.1,.local
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=